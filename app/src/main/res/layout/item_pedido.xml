<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="12dp">

        <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

            <TextView android:id="@+id/tvCliente" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"/>

            <TextView android:id="@+id/tvTotalPedido" android:layout_height="wrap_content" android:layout_width="wrap_content" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/tvTelefono" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:textColor="@color/gray_text" android:textSize="13sp"/>

        <TextView android:id="@+id/tvFecha" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:textColor="@color/gray_text" android:textSize="12sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>